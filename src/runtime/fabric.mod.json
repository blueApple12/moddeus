{
	"schemaVersion": 1,
	"id": "moddeus",
	"version": "${version}-runtime",
	"name": "Moddeus Runtime",
	"description": "Runs mods made with Moddeus (content, VFX, physics, keys, GUIs). No AI, no chat: just the mods.",
	"authors": ["Moddeus"],
	"license": "MIT",
	"icon": "assets/moddeus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.moddeus.live.Standalone"],
		"client": ["dev.moddeus.client.StandaloneClient"]
	},
	"mixins": ["moddeus.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
